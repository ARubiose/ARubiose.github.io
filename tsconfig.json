{
    "extends": "astro/tsconfigs/strict",
    "include": [
        ".astro/types.d.ts",
        "**/*"
    ],
    "exclude": [
        "dist"
    ],
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@components/*": [
                "src/components/*"
            ],
            "@styles/*": [
                "src/styles/*"
            ],
            "@layouts/*": [
                "src/layouts/*"
            ],
            "@assets/*": [
                "src/assets/*"
            ],
            "@sections/*": [
                "src/sections/*"
            ],
            "@lib/*": [
                "src/lib/*"
            ],
            "@i18n/*": [
                "src/i18n/*"
            ]
        }
    }
}