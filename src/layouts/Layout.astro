---
import "@styles/global.css";
import { Font } from "astro:assets";
import type { Locale } from "@i18n/ui";
import { defaultSkin, skinBootScript, timelineOf } from "@lib/skins";
import { jsonLdScript, requireSite, type AlternateLink } from "@lib/seo";

interface Props {
    locale: Locale;
    title: string;
    description: string;
    alternates?: AlternateLink[];
    jsonLd?: object;
}
const { locale, title, description, alternates = [], jsonLd } = Astro.props;
const site = requireSite(Astro.site);
// Las vistas previas al compartir (LinkedIn, WhatsApp…) y los buscadores exigen URLs absolutas.
const pageUrl = new URL(Astro.url.pathname, site).href;
const ogImage = new URL("/og-image.png", site).href;
---

<!doctype html>
<html lang={locale} data-skin={defaultSkin} data-timeline={timelineOf(defaultSkin)}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="color-scheme" content="dark" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={pageUrl} />
        {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
        {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLdScript(jsonLd)} />}
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:locale" content={locale === "es" ? "es_ES" : "en_US"} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={pageUrl} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="627" />
        <meta property="og:image:alt" content={title} />
        <meta name="twitter:card" content="summary_large_image" />
        <Font cssVariable="--font-space-grotesk" preload />
        <Font cssVariable="--font-ibm-plex-mono" preload />
        {/* Fuentes de Táctico y Juego, sin precarga: solo se descargan si la skin activa las usa. */}
        <Font cssVariable="--font-chakra-petch" />
        <Font cssVariable="--font-barlow" />
        <Font cssVariable="--font-jetbrains-mono" />
        <Font cssVariable="--font-saira-condensed" />
        <Font cssVariable="--font-geist" />
        <Font cssVariable="--font-geist-mono" />
        <script is:inline set:html={skinBootScript()} />
    </head>
    <body class="bg-bg text-text font-body">
        <slot />
    </body>
</html>
