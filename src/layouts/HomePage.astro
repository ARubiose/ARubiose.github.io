---
import { getImage } from "astro:assets";
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from "astro:i18n";
import { locales, type Locale } from "@i18n/ui";
import { cvUrl } from "@lib/cv";
import { buildHomeView, handleFromName, shortNameFromName } from "@lib/home";
import { useTranslations } from "@i18n/utils";
import { loadHomeData } from "@lib/content";
import { alternateLinks, personJsonLd, requireSite } from "@lib/seo";
import { analyticsBeacon } from "@lib/analytics";
import { buildMonth } from "@lib/site";
import { PUBLIC_CF_ANALYTICS_TOKEN } from "astro:env/client";
import Layout from "./Layout.astro";
import Header from "@components/Header.astro";
import Intro from "@sections/intro.astro";
import Experience from "@sections/experience.astro";
import Projects from "@sections/projects.astro";
import Skills from "@sections/skills.astro";
import Education from "@sections/education.astro";
import Contact from "@sections/contact.astro";
import Footer from "@components/Footer.astro";

interface Props {
    locale: Locale;
}
const { locale } = Astro.props;

const data = await loadHomeData();
const now = buildMonth(process.env);
const view = buildHomeView(data, locale, now);

const urls = Object.fromEntries(locales.map((l) => [l, getRelativeLocaleUrl(l, "")])) as Record<Locale, string>;

// SEO: URLs absolutas de cada idioma y foto optimizada (nunca el original de la wiki).
const site = requireSite(Astro.site);
const absoluteUrls = Object.fromEntries(locales.map((l) => [l, getAbsoluteLocaleUrl(l, "")])) as Record<Locale, string>;
const photo = await getImage({ src: data.profile.photo, width: 400, format: "webp" });
const jsonLd = personJsonLd(data, locale, { url: absoluteUrls[locale], image: new URL(photo.src, site).href });

const analytics = analyticsBeacon(PUBLIC_CF_ANALYTICS_TOKEN, import.meta.env.PROD);
const cvHref = cvUrl(locale, import.meta.env.BASE_URL);
const t = useTranslations(locale);
---

<Layout locale={locale} title={`${view.profile.name} · ${view.profile.headline}`} description={view.profile.summary} alternates={alternateLinks(absoluteUrls)} jsonLd={jsonLd} analytics={analytics}>
    <Header locale={locale} sections={view.sections} urls={urls} handle={handleFromName(view.profile.name)} shortName={shortNameFromName(view.profile.name)} pages={[{ href: cvHref, label: t("nav.cv") }]} />
    <main class="mx-auto max-w-6xl px-4 md:px-10">
        <Intro profile={view.profile} locale={locale} cvHref={cvHref} />
        <Experience items={view.experience} locale={locale} />
        <Projects items={view.projects} locale={locale} />
        <Skills groups={view.skillGroups} locale={locale} profile={view.profile} professionalXp={view.professionalXp} usage={view.usage} entryNames={view.entryNames} />
        <Education items={view.education} locale={locale} />
        <Contact links={view.profile.links} locale={locale} cvHref={cvHref} />
    </main>
    <Footer locale={locale} repo={view.siteRepo} analytics={analytics !== null} />
</Layout>

<script>
    import { initMotion } from "../scripts/motion";
    initMotion();
</script>
