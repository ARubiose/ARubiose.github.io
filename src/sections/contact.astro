---
import Adorn from "@components/Adorn.astro";
import type { Locale } from "@i18n/ui";
import { useTranslations } from "@i18n/utils";
import { displayUrl, type HomeView } from "@lib/home";

interface Props {
    links: HomeView["profile"]["links"];
    locale: Locale;
}
const { links, locale } = Astro.props;
const t = useTranslations(locale);
const rows = [
    { cmd: "mailCmd" as const, href: `mailto:${links.email}`, text: links.email, label: t("contact.email"), external: false },
    { cmd: "openCmd" as const, href: links.linkedin, text: displayUrl(links.linkedin), label: t("contact.linkedin"), external: true },
    { cmd: "openCmd" as const, href: links.github, text: displayUrl(links.github), label: t("contact.github"), external: true },
];
---

<section id="contact" class="mt-11 md:mt-18">
    <h2 class="section-title mb-4 text-[26px] md:mb-5 md:text-[30px]">{t("section.contact")}<Adorn name="sectionSub.contact" locale={locale} class="section-sub" /></h2>
    <ul class="grid gap-2.5 text-[15px] md:text-[16px]">
        {rows.map((r) => (
            <li>
                <a class="group inline-flex flex-wrap gap-x-2.5" href={r.href} aria-label={`${r.label}: ${r.text}`} {...(r.external ? { target: "_blank", rel: "noopener" } : {})}>
                    <span class="text-accent" aria-hidden="true"><Adorn name={r.cmd} locale={locale} /></span>
                    <span class="break-all border-b border-transparent group-hover:border-accent">{r.text}</span>
                </a>
            </li>
        ))}
    </ul>
</section>
