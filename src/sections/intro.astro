---
import Adorn from "@components/Adorn.astro";
import ProfilePhoto from "@components/ProfilePhoto.astro";
import type { Locale } from "@i18n/ui";
import { useTranslations } from "@i18n/utils";
import type { HomeView } from "@lib/home";

interface Props {
    profile: HomeView["profile"];
    locale: Locale;
}
const { profile, locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="about" class="hero grid gap-(--hero-gap) pt-6 md:grid-cols-(--hero-cols) md:items-center md:gap-13 md:pt-14">
    <ProfilePhoto name={profile.name} photo={profile.photo} locale={locale} />
    <div class="hero-text">
        <p class="prompt text-[13px]" aria-hidden="true"><Adorn name="heroKicker" locale={locale} /></p>
        <h1 class="relative mt-2 font-display text-(length:--hero-name-size) leading-(--hero-name-leading) font-(--hero-name-weight) tracking-tight md:text-(length:--hero-name-size-md)">
            <span class="hero-name">{profile.name}</span><span class="cursor" aria-hidden="true"></span>
        </h1>
        <p class="hero-role mt-2.5 font-display text-[19px] md:text-[23px]">{profile.headline}</p>
        <p class="hero-loc text-[13px] text-muted">{profile.location}</p>
        <p class="hero-sum mt-4 max-w-[56ch] text-[13.5px] leading-[1.7] text-body md:text-[14.5px]">{profile.summary}</p>
        <div class="hero-cta mt-6 grid grid-cols-2 gap-3 md:flex">
            <a class="btn btn-primary" href="#contact">{t("hero.contact")}</a>
            <a class="btn btn-secondary" href={profile.links.github} target="_blank" rel="noopener">{t("hero.github")}</a>
        </div>
    </div>
</section>
